{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@total-typescript/tsconfig/bundler/no-dom/app",
  "compilerOptions": {
    "lib": ["ES2025"],
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.scripts.tsbuildinfo"
  },
  "include": ["scripts"]
}
